# Spack versions for all workflows (build-package.yml and ci.yml). Each
# workflow loads the NAME=value lines into its environment after checkout.
#
# Bump deliberately. A new spack-packages commit re-solves the dependency
# graph and can invalidate cached binaries. Latest develop commit:
#   git ls-remote https://github.com/spack/spack-packages.git refs/heads/develop

# Spack release
SPACK_VERSION=v1.2.2
# spack/spack-packages (builtin package repository) commit: develop, 2026-11-22
SPACK_PACKAGES_COMMIT=731577eee0004659abb29a12e42d4c52a48e7285
